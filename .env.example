LITELLM_MASTER_KEY=sk-change-me
GROQ_API_KEY=gsk_...
# public url of the proxy, needed for oauth redirect validation behind nginx
PROXY_BASE_URL=https://example.com/litellm
SERVER_ROOT_PATH=/litellm
# only for variant C (any sentry.io auth token, to show it is rejected by mcp.sentry.dev)
SENTRY_IO_TOKEN=
